{
  "name": "family-cart-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Member 3 module: OpenAI + OpenRouter + Exa pipeline for the family dietary checkout agent",
  "main": "dist/analyzeCart.js",
  "types": "dist/analyzeCart.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
